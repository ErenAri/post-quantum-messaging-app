[Unit]
Description=PQmsg backend stack (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pqmsg/deploy/aws/ec2
ExecStart=/usr/bin/docker compose --env-file /opt/pqmsg/deploy/aws/ec2/.env -f /opt/pqmsg/deploy/aws/ec2/docker-compose.ec2.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/pqmsg/deploy/aws/ec2/.env -f /opt/pqmsg/deploy/aws/ec2/docker-compose.ec2.yml down
RemainAfterExit=yes
TimeoutStartSec=0
User=ubuntu
Group=docker

[Install]
WantedBy=multi-user.target
