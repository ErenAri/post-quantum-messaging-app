# Copy this file to pqmsg-server.aws.env and edit values.
# This default profile is intended for low-cost EC2 dev/testing.

PQMSG_DEPLOYMENT_MODE=development
PQMSG_SECURITY_PROFILE=research
PQMSG_WEB_CLIENT_POLICY=interop_candidate
PQMSG_CORS_ALLOWED_ORIGINS=https://pqmsg-web.pages.dev
PQMSG_LOG_FORMAT=json
RUST_LOG=pqmsg_server=info

PQMSG_DB_MAX_CONNECTIONS=30
PQMSG_DB_MIN_CONNECTIONS=5
PQMSG_DB_ACQUIRE_TIMEOUT_SECS=5
PQMSG_DB_IDLE_TIMEOUT_SECS=300

PQMSG_RATE_LIMIT_CAPACITY=120
PQMSG_RATE_LIMIT_REFILL_PER_SECOND=4
PQMSG_RATE_LIMIT_MAX_ENTRIES=50000
PQMSG_RATE_LIMIT_BUCKET_TTL_SECS=600

PQMSG_REGISTRATION_POW_BITS=18
PQMSG_PREKEY_PUBLISH_MIN_INTERVAL_SECONDS=30
PQMSG_PREKEY_BUNDLE_RESERVE_COUNT=2

# Uncomment and set for hardened pilot/production contract.
# PQMSG_DEPLOYMENT_MODE=pilot
# PQMSG_SECURITY_PROFILE=high_assurance
# PQMSG_POSTGRES_STORAGE_ENCRYPTION=managed_service
# PQMSG_POSTGRES_BACKUP_ENCRYPTION=true
# PQMSG_TLS_CERT_PATH=/etc/pqmsg/tls/tls.crt
# PQMSG_TLS_KEY_PATH=/etc/pqmsg/tls/tls.key
# PQMSG_AUDIT_LOG_PATH=/var/log/pqmsg/audit.log
