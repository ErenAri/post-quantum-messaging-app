# Public DNS record that points to the EC2 instance.
API_DOMAIN=api.example.com

# Email used by Let's Encrypt / ACME registration.
ACME_EMAIL=ops@example.com

# Password for local Postgres container.
POSTGRES_PASSWORD=replace-with-strong-password

# Override with digest-pinned production image when available.
PQMSG_SERVER_IMAGE=ghcr.io/your-org/pqmsg-server:0.1.0
