type key.
type pkey.

free net: channel.

fun pk(key): pkey.
fun dh(key, pkey): bitstring.
reduc forall x:key, y:key; dh(x, pk(y)) = dh(y, pk(x)).

fun sign(bitstring, key): bitstring.
fun verify(bitstring, bitstring, pkey): bool.
reduc forall m:bitstring, sk:key; verify(sign(m, sk), m, pk(sk)) = true.

fun kem_enc(pkey, bitstring): bitstring.
fun kem_ss(key, bitstring): bitstring.
reduc forall sk:key, ss:bitstring; kem_ss(sk, kem_enc(pk(sk), ss)) = ss.

fun hkdf(bitstring, bitstring): bitstring.
fun tuple4(bitstring, bitstring, bitstring, bitstring): bitstring.
fun tuple3(pkey, pkey, bitstring): bitstring.
fun aead_enc(bitstring, bitstring, bitstring): bitstring.

free protocol_v1: bitstring.
free alice_id: bitstring.
free bob_id: bitstring.
free plaintext0: bitstring [private].
free plaintext_fs: bitstring [private].

event BobBundlePublished(bitstring, pkey, pkey, pkey).
event AliceAcceptedBundle(bitstring, bitstring).
event AliceComplete(bitstring, bitstring, bitstring).
event BobComplete(bitstring, bitstring, bitstring).
(* Forward secrecy events *)
event EphemeralKeyRevealed(bitstring).
(* Identity misbinding: capture the full identity pair in the session *)
event SessionBound(pkey, pkey, bitstring).

let Bob =
  new ik_b:key;
  new spk_b:key;
  new pqspk_b:key;
  let ik_b_pub = pk(ik_b) in
  let spk_b_pub = pk(spk_b) in
  let pqspk_b_pub = pk(pqspk_b) in
  let sig_spk = sign(spk_b_pub, ik_b) in
  let sig_pqspk = sign(pqspk_b_pub, ik_b) in
  event BobBundlePublished(bob_id, ik_b_pub, spk_b_pub, pqspk_b_pub);
  out(net, (bob_id, ik_b_pub, spk_b_pub, pqspk_b_pub, sig_spk, sig_pqspk));
  in(net, (ik_a_pub:pkey, ek_a_pub:pkey, pq_ct:bitstring, ad:bitstring, ciphertext:bitstring));
  let ss_pq = kem_ss(pqspk_b, pq_ct) in
  let t1 = dh(spk_b, ik_a_pub) in
  let t2 = dh(ik_b, ek_a_pub) in
  let t3 = dh(spk_b, ek_a_pub) in
  let sk = hkdf(tuple4(t1, t2, t3, ss_pq), ad) in
  event SessionBound(ik_a_pub, ik_b_pub, sk);
  event BobComplete(alice_id, bob_id, sk).

let Alice =
  new ik_a:key;
  in(net, (target_id:bitstring, ik_b_pub:pkey, spk_b_pub:pkey, pqspk_b_pub:pkey, sig_spk:bitstring, sig_pqspk:bitstring));
  if target_id = bob_id then
    if verify(sig_spk, spk_b_pub, ik_b_pub) = true then
      if verify(sig_pqspk, pqspk_b_pub, ik_b_pub) = true then
        event AliceAcceptedBundle(alice_id, bob_id);
        new ek_a:key;
        new ss_pq:bitstring;
        let pq_ct = kem_enc(pqspk_b_pub, ss_pq) in
        let t1 = dh(ik_a, spk_b_pub) in
        let t2 = dh(ek_a, ik_b_pub) in
        let t3 = dh(ek_a, spk_b_pub) in
        let ad = tuple3(pk(ik_a), ik_b_pub, protocol_v1) in
        let sk = hkdf(tuple4(t1, t2, t3, ss_pq), ad) in
        let ciphertext = aead_enc(plaintext0, sk, ad) in
        event SessionBound(pk(ik_a), ik_b_pub, sk);
        event AliceComplete(alice_id, bob_id, sk);
        out(net, (pk(ik_a), pk(ek_a), pq_ct, ad, ciphertext)).

(* ── Forward secrecy process ───────────────────────────────────────
   Alice uses a fresh ephemeral key then reveals it after session setup.
   plaintext_fs must remain secret despite the later ephemeral key compromise. *)
let AliceFS =
  new ik_a:key;
  in(net, (target_id:bitstring, ik_b_pub:pkey, spk_b_pub:pkey, pqspk_b_pub:pkey, sig_spk:bitstring, sig_pqspk:bitstring));
  if target_id = bob_id then
    if verify(sig_spk, spk_b_pub, ik_b_pub) = true then
      if verify(sig_pqspk, pqspk_b_pub, ik_b_pub) = true then
        new ek_a:key;
        new ss_pq:bitstring;
        let pq_ct = kem_enc(pqspk_b_pub, ss_pq) in
        let t1 = dh(ik_a, spk_b_pub) in
        let t2 = dh(ek_a, ik_b_pub) in
        let t3 = dh(ek_a, spk_b_pub) in
        let ad = tuple3(pk(ik_a), ik_b_pub, protocol_v1) in
        let sk = hkdf(tuple4(t1, t2, t3, ss_pq), ad) in
        let ciphertext = aead_enc(plaintext_fs, sk, ad) in
        out(net, (pk(ik_a), pk(ek_a), pq_ct, ad, ciphertext));
        (* Reveal the ephemeral key AFTER the session is established *)
        event EphemeralKeyRevealed(alice_id);
        out(net, ek_a).

(* ── Original queries ──────────────────────────────────────────── *)
query attacker(plaintext0).
query a:bitstring, b:bitstring, k:bitstring;
  event(AliceComplete(a, b, k)) ==> not attacker(k).
query a:bitstring, b:bitstring, k:bitstring;
  event(BobComplete(a, b, k)) ==> event(AliceComplete(a, b, k)).
query a:bitstring, b:bitstring, k:bitstring;
  event(BobComplete(a, b, k)) ==> event(AliceAcceptedBundle(a, b)).

(* ── Forward secrecy ──────────────────────────────────────────────
   Even after ephemeral key is revealed, plaintext_fs must stay secret.
   ProVerif models the attacker as having the capability to learn ek_a
   from the out(net, ek_a) above. The KEM shared secret ss_pq was
   generated freshly and never revealed, so the session key remains
   unrecoverable. *)
query attacker(plaintext_fs).

(* ── Identity misbinding resistance ───────────────────────────────
   If both Alice and Bob compute the same session key, they must agree
   on the identity key pair involved in the session. *)
query ik_a:pkey, ik_b:pkey, ik_a2:pkey, ik_b2:pkey, k:bitstring;
  event(SessionBound(ik_a, ik_b, k)) && event(SessionBound(ik_a2, ik_b2, k))
    ==> ik_a = ik_a2 && ik_b = ik_b2.

process
  (!Bob | !Alice | !AliceFS)
