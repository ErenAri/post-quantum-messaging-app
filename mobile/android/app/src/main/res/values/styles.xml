<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.PQMsg.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PQMsg.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.PQMsg.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/pq_surface</item>
    </style>

    <style name="Widget.PQMsg.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/pq_surface_alt</item>
        <item name="boxStrokeColor">@color/pq_line</item>
        <item name="boxCornerRadiusTopStart">22dp</item>
        <item name="boxCornerRadiusTopEnd">22dp</item>
        <item name="boxCornerRadiusBottomStart">22dp</item>
        <item name="boxCornerRadiusBottomEnd">22dp</item>
        <item name="hintTextColor">@color/pq_ink_muted</item>
        <item name="android:textColorHint">@color/pq_ink_muted</item>
    </style>

    <style name="Widget.PQMsg.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/pq_hero</item>
        <item name="android:textColor">@color/pq_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="rippleColor">@color/pq_hero_accent</item>
    </style>

    <style name="Widget.PQMsg.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/pq_line</item>
        <item name="android:textColor">@color/pq_ink</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.PQMsg.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">22dp</item>
        <item name="backgroundTint">@color/pq_surface_alt</item>
        <item name="android:textColor">@color/pq_hero</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.PQMsg.Button.Compose" parent="Widget.PQMsg.Button.Tonal">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.PQMsg.Button.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/pq_error</item>
        <item name="android:textColor">@color/pq_error</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PQMsg.Eyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pq_ink_muted</item>
    </style>

    <style name="Widget.PQMsg.Button.Compact" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/pq_line</item>
        <item name="android:textColor">@color/pq_ink</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="Widget.PQMsg.Button.Icon" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/pq_toolbar_icon_bg</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/pq_toolbar_icon_fg</item>
        <item name="rippleColor">@color/pq_hero_accent</item>
    </style>

    <style name="Widget.PQMsg.Button.IconPrimary" parent="Widget.PQMsg.Button.Icon">
        <item name="backgroundTint">@color/pq_hero</item>
        <item name="iconTint">@color/pq_surface</item>
    </style>

    <style name="Widget.PQMsg.Button.Toolbar" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/pq_line</item>
        <item name="android:textColor">@color/pq_ink_muted</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PQMsg.Button.Filter" parent="Widget.PQMsg.Button.Compact">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.PQMsg.Chip.Reaction" parent="Widget.MaterialComponents.Chip.Action">
        <item name="shapeAppearance">@style/ShapeAppearance.PQMsg.Small</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:checkable">false</item>
        <item name="closeIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="TextAppearance.PQMsg.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pq_ink</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.PQMsg.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pq_ink</item>
    </style>

    <style name="TextAppearance.PQMsg.BodyMuted" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/pq_ink_muted</item>
    </style>

    <style name="TextAppearance.PQMsg.Mono" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/pq_ink</item>
    </style>

    <style name="TextAppearance.PQMsg.CaptionStrong" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/pq_ink_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
