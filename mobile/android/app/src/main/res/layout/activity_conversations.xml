<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure chats"
                android:textAppearance="@style/TextAppearance.PQMsg.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/conversations_title"
                android:textAppearance="@style/TextAppearance.PQMsg.ScreenTitle" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRefreshConversations"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_refresh_conversations" />

        <TextView
            android:id="@+id/textProfileMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle"
            android:textColor="@color/pq_toolbar_icon_fg" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCurrentProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

    <TextView
        android:id="@+id/textConversationsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonComposeConversation"
            style="@style/Widget.PQMsg.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/button_compose_conversation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonArchivedConversations"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/button_open_archived_conversations"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterAll"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterUnread"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_unread" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterGroups"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_groups" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterRequests"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_requests" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/listConversations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:listSelector="?attr/colorControlHighlight" />

            <TextView
                android:id="@+id/textConversationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="28dp"
                android:text="@string/conversations_empty"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
