<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textAppearance="@style/TextAppearance.PQMsg.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/conversations_title"
                android:textAppearance="@style/TextAppearance.PQMsg.ScreenTitle" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSearchConversations"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_search_conversations"
            app:icon="@drawable/ic_search_20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonArchivedConversations"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/button_open_archived_conversations"
            android:visibility="gone"
            app:icon="@drawable/ic_archive_18"
            app:iconPadding="6dp" />

        <TextView
            android:id="@+id/textProfileMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_avatar_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle"
            android:textColor="@color/pq_toolbar_icon_fg" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCurrentProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

    <TextView
        android:id="@+id/textConversationsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

    <LinearLayout
        android:id="@+id/layoutConversationSearchMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PQMsg.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editConversationSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/conversations_search_hint"
                android:imeOptions="actionSearch"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCloseConversationSearch"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/thread_search_close"
            app:icon="@drawable/ic_close_20" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutConversationComposeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonComposeConversation"
            style="@style/Widget.PQMsg.Button.Compose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/button_compose_conversation"
            app:icon="@drawable/ic_edit_20"
            app:iconPadding="8dp"
            app:iconTint="@color/pq_hero" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterAll"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterUnread"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_unread" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterGroups"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_groups" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFilterRequests"
            style="@style/Widget.PQMsg.Button.Filter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/conversations_filter_requests" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="-16dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/listConversations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@color/pq_line"
                android:dividerHeight="1dp"
                android:listSelector="?attr/colorControlHighlight"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/textConversationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="28dp"
                android:text="@string/conversations_empty"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
