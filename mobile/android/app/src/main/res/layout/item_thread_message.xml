<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textThreadMessageDayHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_thread_day_header"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong"
        android:textColor="@color/pq_ink_muted"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/threadMessageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp">

        <LinearLayout
            android:id="@+id/threadMessageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginEnd="48dp"
            android:orientation="vertical"
            android:paddingHorizontal="13dp"
            android:paddingTop="8dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/textThreadMessageReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:maxWidth="280dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/pq_ink_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textThreadMessageBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/threadMessageReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThreadReplies"
                style="@style/Widget.PQMsg.Chip.Reaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:ensureMinTouchTargetSize="false" />

            <TextView
                android:id="@+id/textThreadMessageMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
