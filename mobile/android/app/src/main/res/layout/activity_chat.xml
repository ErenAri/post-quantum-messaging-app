<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBackSetup"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_back"
            app:icon="@drawable/ic_arrow_back_20" />

        <LinearLayout
            android:id="@+id/chatHeaderContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_secondary_direct"
                android:textAppearance="@style/TextAppearance.PQMsg.Eyebrow" />

            <TextView
                android:id="@+id/textChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_title"
                android:textAppearance="@style/TextAppearance.PQMsg.ScreenTitle" />

            <TextView
                android:id="@+id/textChatMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonThreadMore"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_more"
            app:icon="@drawable/ic_more_vert_20" />
    </LinearLayout>

    <TextView
        android:id="@+id/textErrorSummaryChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/pq_error"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonToggleErrorDetailsChat"
        style="@style/Widget.PQMsg.Button.Compact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/button_show_error_details"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textErrorDetailsChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_detail_panel"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.PQMsg.Mono"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutChatSelectionMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textChatSelectionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonChatSelectionCopy"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thread_selection_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonChatSelectionShare"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonChatSelectionDelete"
                style="@style/Widget.PQMsg.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonChatSelectionClose"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_close" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutChatSearchMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PQMsg.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/thread_search_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editThreadSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonThreadSearchPrev"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_previous" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonThreadSearchNext"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_next" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonThreadSearchClose"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/textThreadSearchCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/thread_search_empty"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_thread_panel"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ListView
            android:id="@+id/listChatMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingHorizontal="8dp"
            android:transcriptMode="alwaysScroll" />

        <TextView
            android:id="@+id/textChatEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/chat_log_empty"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.PQMsg.Card"
        android:id="@+id/cardAttachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/textAttachmentPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

            <TextView
                android:id="@+id/textAttachmentPreviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutReplyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textReplyPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearReply"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/button_clear_reply" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutChatComposerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_composer_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAttachMedia"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_attach_media"
            app:icon="@drawable/ic_add_20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearAttachment"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/button_clear_attachment"
            android:visibility="gone"
            app:icon="@drawable/ic_close_20" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PQMsg.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/hint_message"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoEnterAction"
                android:maxHeight="144dp"
                android:maxLines="5"
                android:minLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSend"
            style="@style/Widget.PQMsg.Button.IconPrimary"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/button_send"
            app:icon="@drawable/ic_send_20" />
    </LinearLayout>
</LinearLayout>
