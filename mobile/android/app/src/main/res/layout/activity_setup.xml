<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure chats"
            android:textAppearance="@style/TextAppearance.PQMsg.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_title"
            android:textAppearance="@style/TextAppearance.PQMsg.ScreenTitle" />

        <TextView
            android:id="@+id/textSetupSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

        <TextView
            android:id="@+id/textCryptoProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_crypto_profile_loading"
            android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_section_create_title"
                    android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setup_section_create_body"
                    android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PQMsg.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hint_user">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_local_keys_note"
                    android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCreateProfile"
                    style="@style/Widget.PQMsg.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/button_create_profile" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonOpenSetupPrivacyPolicy"
                    style="@style/Widget.PQMsg.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/button_open_privacy_policy" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setup_privacy_note"
                    android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonToggleAdvancedSetup"
                    style="@style/Widget.PQMsg.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_show_advanced_setup" />

                <LinearLayout
                    android:id="@+id/layoutAdvancedSetup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_advanced_title"
                        android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PQMsg.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_server">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editServer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PQMsg.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_device">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editDevice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PQMsg.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_suite">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSuite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.PQMsg.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_push_token">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPushToken"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/setup_demo_presets_title"
                        android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPresetAlice"
                            style="@style/Widget.PQMsg.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/button_preset_alice" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPresetBob"
                            style="@style/Widget.PQMsg.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/button_preset_bob" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_section_linked_title"
                    android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setup_section_linked_body"
                    android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonToggleLinkedDeviceImport"
                    style="@style/Widget.PQMsg.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_show_linked_device_import" />

                <LinearLayout
                    android:id="@+id/layoutLinkedDeviceImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PQMsg.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_onboarding_passphrase">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editOnboardingPassphrase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.PQMsg.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/hint_onboarding_package">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editOnboardingPackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                    android:id="@+id/textOnboardingPackagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_detail_panel"
                    android:padding="12dp"
                    android:textAppearance="@style/TextAppearance.PQMsg.Mono"
                    android:visibility="gone" />

                    <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPasteOnboardingPackage"
                        style="@style/Widget.PQMsg.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/button_paste_onboarding_package" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonImportOnboardingPackage"
                        style="@style/Widget.PQMsg.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/button_import_onboarding_package" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textStatusSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.PQMsg.CaptionStrong" />

        <TextView
            android:id="@+id/textErrorSummarySetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pq_error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToggleErrorDetailsSetup"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_show_error_details"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textErrorDetailsSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_detail_panel"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.PQMsg.Mono"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
