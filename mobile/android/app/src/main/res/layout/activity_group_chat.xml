<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBackFromGroup"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_back"
            app:icon="@drawable/ic_arrow_back_20" />

        <LinearLayout
            android:id="@+id/groupHeaderContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversation_state_group"
                android:textAppearance="@style/TextAppearance.PQMsg.Eyebrow" />

            <TextView
                android:id="@+id/textGroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_chat_title"
                android:textAppearance="@style/TextAppearance.PQMsg.ScreenTitle" />

            <TextView
                android:id="@+id/textGroupMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGroupThreadMore"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_more"
            app:icon="@drawable/ic_more_vert_20" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGroupSelectionMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textGroupSelectionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupSelectionCopy"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thread_selection_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupSelectionShare"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupSelectionDelete"
                style="@style/Widget.PQMsg.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupSelectionClose"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_selection_close" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGroupSearchMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PQMsg.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/thread_search_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGroupThreadSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupThreadSearchPrev"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_previous" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupThreadSearchNext"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_next" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupThreadSearchClose"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/thread_search_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/textGroupThreadSearchCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/thread_search_empty"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_thread_panel"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ListView
            android:id="@+id/listGroupMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingHorizontal="8dp"
            android:transcriptMode="alwaysScroll" />

        <LinearLayout
            android:id="@+id/layoutGroupEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp">

            <TextView
                android:id="@+id/textGroupEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textGroupChatEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/group_chat_log_empty"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGroupEmptyBack"
                style="@style/Widget.PQMsg.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/button_back_conversations"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.PQMsg.Card"
        android:id="@+id/cardGroupAttachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/textGroupAttachmentPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PQMsg.SectionTitle" />

            <TextView
                android:id="@+id/textGroupAttachmentPreviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutGroupReplyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thread_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textGroupReplyPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PQMsg.BodyMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearGroupReply"
            style="@style/Widget.PQMsg.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/button_clear_reply" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGroupComposerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_composer_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAttachGroupMedia"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/button_attach_media"
            app:icon="@drawable/ic_add_20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearGroupAttachment"
            style="@style/Widget.PQMsg.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/button_clear_attachment"
            android:visibility="gone"
            app:icon="@drawable/ic_close_20" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PQMsg.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editGroupMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/hint_message"
                android:inputType="textMultiLine"
                android:imeOptions="flagNoEnterAction"
                android:maxHeight="144dp"
                android:maxLines="5"
                android:minLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSendGroup"
            style="@style/Widget.PQMsg.Button.IconPrimary"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/button_send"
            app:icon="@drawable/ic_send_20" />
    </LinearLayout>
</LinearLayout>
